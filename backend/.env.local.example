# ==============================
# Variables para correr LOCALMENTE el script de importación histórica
# (npm run import:historico) — independiente del .env que usa el
# backend desplegado en Render, ya que este script se ejecuta desde tu
# propia máquina, nunca en el servidor.
# ==============================

# Connection string del POOLER de Supabase, modo Transaction (puerto
# 6543) — la misma que usa el backend desplegado. Ver backend/.env.example
# para instrucciones de dónde obtenerla.
DATABASE_URL=postgresql://postgres.mzhltfwxxudskzypsrqd:[YOUR-PASSWORD]@aws-0-us-west-2.pooler.supabase.com:6543/postgres

# ==============================
# Variables adicionales para correr LOCALMENTE el backfill de Google
# Analytics 4 (npm run ga:backfill) — igual razón que arriba: corre desde
# tu máquina, nunca en el servidor.
# ==============================
GA_SERVICE_ACCOUNT_JSON=
GA_PROPERTY_ID_PILATOS=
GA_PROPERTY_ID_KIPLING=
GA_PROPERTY_ID_DIESEL=
GA_PROPERTY_ID_SUPERDRY=
GA_PROPERTY_ID_GIRBAUD=
GA_PROPERTY_ID_REPLAY=
