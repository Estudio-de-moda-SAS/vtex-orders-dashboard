# ==============================
# Configuración general del servidor
# ==============================
PORT=3001
NODE_ENV=development

# URL del frontend permitida por CORS (separar varias con coma si es necesario)
FRONTEND_ORIGIN=http://localhost:3000

# ==============================
# Configuración VTEX (global)
# ==============================
# Máximo de páginas consultadas en paralelo POR VENTANA (no global).
VTEX_PAGE_CONCURRENCY=3
# Cantidad de tiendas consultadas en paralelo.
VTEX_STORE_CONCURRENCY=3
# Límite de concurrencia GLOBAL: se comparte entre TODAS las tiendas y
# TODOS los segmentos (incluyendo los 10 de Pilatos). Es el control más
# importante contra HTTP 429 — nunca hay más de esta cantidad de
# peticiones a VTEX en vuelo al mismo tiempo en TODA la aplicación, sin
# importar cuántas tiendas se consulten en paralelo.
VTEX_GLOBAL_CONCURRENCY=4
# Órdenes por página solicitadas a VTEX. Valores más altos = menos
# peticiones HTTP totales para el mismo volumen de órdenes (no cambia
# cuándo se activa la partición por fecha, solo reduce cuántas llamadas
# hacen falta para llegar ahí). Prueba subirlo si quieres reducir carga;
# si VTEX empieza a rechazarlo, bájalo de vuelta.
VTEX_PER_PAGE=50
# Timeout (ms) por request a VTEX
VTEX_REQUEST_TIMEOUT_MS=15000
# Reintentos ante errores TRANSITORIOS genéricos (timeout, 5xx). El
# rate-limit (429) usa su propio presupuesto de reintentos, ver abajo.
VTEX_MAX_RETRIES=2
# Backoff base (ms) ante un HTTP 429, con crecimiento exponencial
# (2s, 4s, 8s, 16s, 32s...). Un 429 significa "más lento", no "algo se
# rompió" — reintentar rápido casi siempre vuelve a fallar.
VTEX_RATE_LIMIT_BACKOFF_MS=2000
# Reintentos permitidos específicamente ante un 429 (independiente de
# VTEX_MAX_RETRIES). Es más alto porque esperar más tiempo no cuesta
# corrección, solo velocidad.
VTEX_RATE_LIMIT_MAX_RETRIES=5

# ==============================
# Base de datos (Supabase / PostgreSQL)
# ==============================
# Connection string del POOLER de Supabase, modo Transaction (puerto
# 6543) — NO uses el de conexión directa (puerto 5432), por la
# cantidad de usuarios concurrentes esperados. Se obtiene desde el
# panel de Supabase: Project Settings → Database → Connection string
# → pestaña "Direct" → seleccionar "Transaction pooler".
DATABASE_URL=postgresql://postgres.xxxxxxxxxxxx:[TU-CONTRASEÑA]@aws-0-us-west-2.pooler.supabase.com:6543/postgres

# Cada cuántas horas corre el cron de sincronización con VTEX
SYNC_CRON_INTERVAL_HOURS=4

# Cuántos días hacia atrás recalcula el cron en cada corrida (ventana
# de recálculo, para capturar cambios de estado de órdenes recientes)
SYNC_RECALC_WINDOW_DAYS=3

# ==============================
# VTEX: reintentos y paginación
# ==============================
# Rondas adicionales de reintento SOLO para páginas que ya fallaron todos
# sus reintentos individuales. Súbelo si sigues viendo consultas
# marcadas como incompletas (datos menores a los reales).
VTEX_PAGE_RETRY_SWEEPS=3
# Offset máximo (page-1)*per_page considerado seguro. Si una consulta
# necesitaría paginar más profundo, el rango de fechas se divide
# automáticamente en dos mitades (ver README sección 8). Es una
# salvaguarda heurística, no un límite oficial documentado por VTEX.
# Valor calibrado con evidencia real: en al menos una cuenta VTEX se
# observó HTTP 400 consistente a partir del offset 1500 (página 31 con
# per_page=50) — la página 30 (offset 1450) funcionaba bien. Si ves el
# mismo patrón en tus logs (HTTP 400 siempre a partir de la misma
# página), baja este valor por debajo de donde empiece a fallar. El
# sistema también se auto-corrige de forma reactiva si detecta un 400
# aunque este umbral no lo hubiera anticipado.
VTEX_MAX_SAFE_OFFSET=1400
# Duración mínima (minutos) de una sub-ventana antes de dejar de partir el rango.
VTEX_MIN_CHUNK_MINUTES=5
# Profundidad máxima de partición recursiva del rango de fechas.
VTEX_MAX_SPLIT_DEPTH=12

# Divisor para normalizar `totalValue` a la unidad real de la moneda.
# Si al sumar órdenes facturadas obtienes cifras 1000 veces más grandes de lo
# real (ej. "23 mil millones" en vez de "23 millones"), deja el valor en 1000.
# Si la cuenta VTEX entrega el valor en centavos, usa 100. Si ya viene
# correcto, usa 1. Ver backend/src/common/utils/money-normalizer.util.ts
VTEX_MONEY_DIVISOR=1000

# ==============================
# Credenciales por tienda
# ==============================

# Pilatos (pilatos21)
PILATOS_APP_KEY=
PILATOS_APP_TOKEN=
PILATOS_ENVIRONMENT=vtexcommercestable

# Kipling (kiplingco)
KIPLING_APP_KEY=
KIPLING_APP_TOKEN=
KIPLING_ENVIRONMENT=vtexcommercestable

# Diesel (dieselcolombia)
DIESEL_APP_KEY=
DIESEL_APP_TOKEN=
DIESEL_ENVIRONMENT=vtexcommercestable

# Superdry (superdrycolombia)
SUPERDRY_APP_KEY=
SUPERDRY_APP_TOKEN=
SUPERDRY_ENVIRONMENT=vtexcommercestable

# Girbaud (girbaud)
GIRBAUD_APP_KEY=
GIRBAUD_APP_TOKEN=
GIRBAUD_ENVIRONMENT=vtexcommercestable

# Replay (replaycolombia)
REPLAY_APP_KEY=
REPLAY_APP_TOKEN=
REPLAY_ENVIRONMENT=vtexcommercestable
